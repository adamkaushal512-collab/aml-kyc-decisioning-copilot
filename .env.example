# Copy this file to .env and fill in real values. .env is gitignored;
# this file is safe to commit as a template for anyone setting up the project.

# Langfuse (observability/tracing) - see docker-compose.langfuse.yml for the
# local self-hosted stack. Get these from the Langfuse UI (http://localhost:3000,
# once the stack is running) under Settings -> API Keys for your project.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-replace-with-your-secret-key
LANGFUSE_HOST=http://localhost:3000
